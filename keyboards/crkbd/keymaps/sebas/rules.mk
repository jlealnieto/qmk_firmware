# Sin VIA: el keymap del repo es la única fuente de verdad
VIA_ENABLE        = no
LTO_ENABLE        = yes

# Per-key RGB (rev1 trae rgblight por defecto, que no permite colores por tecla)
RGBLIGHT_ENABLE   = no
RGB_MATRIX_ENABLE = yes

OLED_ENABLE       = yes
CAPS_WORD_ENABLE  = yes
# WPM no se muestra como número: acelera el gas de Gastly en la OLED izquierda
WPM_ENABLE        = yes
MOUSEKEY_ENABLE   = no
